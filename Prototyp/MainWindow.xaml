<Window x:Class="Prototyp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prototyp"
        mc:Ignorable="d"
        Title="Prototyp - Spritzgussmaschine" Height="600" Width="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Label Grid.Column="1" Grid.Row="0" Content="3" VerticalAlignment="Center" HorizontalAlignment="Center" 
               FontSize="50" FontWeight="Bold" Foreground="#669d34"/>

        <Label Grid.Column="0" Grid.Row="3" Content="Standardmikrofon: Intel XY" VerticalAlignment="Bottom"
               FontSize="14" Foreground="DimGray" Padding="8"/>

        <Button Grid.Column="1" Grid.Row="3" Content="Start" VerticalAlignment="Top" Background="#75bd33"
                Width="120" Height="30" FontSize="18" FontWeight="Medium" x:Name="toggleButton" Click="toggleButton_Click"/>
    </Grid>
</Window>
